<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.centralink.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_home_to_services"
            app:destination="@id/servicesFragment"/>

        <action
            android:id="@+id/action_homeFragment_to_announcementsFragment"
            app:destination="@id/announcementsFragment" />

    </fragment>

    <fragment
        android:id="@+id/servicesFragment"
        android:name="com.example.centralink.ServicesFragment"
        android:label="Services"/>

    <fragment
        android:id="@+id/announcementsFragment"
        android:name="com.example.centralink.AnnouncementsFragment"
        android:label="Announcements" />

</navigation>